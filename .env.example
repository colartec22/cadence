# Copy to .env and fill in only what you actually have configured.
# Cadence works fully without any of these set: local text parsing, reading screenshots in the
# browser, manual scheduling, auto-fill, and localStorage persistence all work with zero config.
# On Vercel, type these into Project -> Settings -> Environment Variables instead (README, "Deploy").
# NEVER commit a real .env file (.gitignore blocks it) and never put a secret in a VITE_ variable.

# ---- Website (safe to be public: bundled into the site's JavaScript) ----
# Address of the Cadence server (the Vercel or Netlify functions at /api/...). Use "/" when the
# functions run on the same site as the app (Vercel), or the full address (https://your-app.vercel.app)
# when the app is on GitHub Pages. Leave empty to run fully local: text parsing and in-browser
# screenshot reading always work, and "Send to Google Calendar" only does a practice run that never
# claims a real sync happened. Only set it once n8n is running (AUTOMATION_URL below): with it set,
# "Send to Google Calendar" stops doing practice runs and needs the real server.
# "Try enhanced reading" (OCR.space) does NOT need this: on Vercel it finds /api/ocr by itself.
VITE_AUTOMATION_API_URL=

# ---- Server only (Vercel functions in api/, or Netlify functions in netlify/functions/) ----
# GitHub Pages can't run servers, so these do nothing there. Each feature stays switched off
# (answers "503 not set up") until the settings it needs are set.
#
# Passcode managers type to sign in before "Try enhanced reading" or sending to Google Calendar. 12+ characters.
MANAGER_PASSCODE=
# Free OCR.space key for "Try enhanced reading" (get one at https://ocr.space/ocrapi). Needs MANAGER_PASSCODE too.
# Server only: never put it in a VITE_ variable, or it would be published inside the website.
OCR_SPACE_API_KEY=
# Address of the n8n server, https only (http is allowed only for localhost while testing).
AUTOMATION_URL=
# Password the n8n webhooks require (n8n Header Auth credential: Name "Authorization", Value "Bearer <this>"). 16+ random characters.
AUTOMATION_SECRET=
# Password n8n uses to call the scheduler service at /api/scheduler/*. 16+ random characters.
SCHEDULER_SECRET=
# Only when the website is hosted somewhere else than the server (GitHub Pages): that website's
# address, so browsers may call the gateway from it. Comma-separated for several. Never "*".
ALLOWED_ORIGINS=

# ---- Build only ----
# The folder the site lives in. GitHub Pages serves this project from /cadence/; the deploy
# workflow sets this for you. Leave empty everywhere else.
BASE_PATH=
